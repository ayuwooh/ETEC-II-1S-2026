<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="5 - Pesquisa de Avalia&#231;&#245;es e M&#233;dia de Idade"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 03:54:25 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjUwOjQ1IFBNOzI2NTY="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjU0OjI1IFBNOzE7Mjc2Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="count, age, review, regularsum" type="Integer" array="False" size=""/>
            <declare name="greatavg, greatage, goodpercent" type="Real" array="False" size=""/>
            <assign variable="regularsum" expression="0"/>
            <assign variable="goodpercent" expression="0"/>
            <assign variable="greatage" expression="0"/>
            <assign variable="greatavg" expression="0"/>
            <for variable="count" start="1" end="15" direction="inc" step="1">
                <input variable="age"/>
                <input variable="review"/>
                <if expression="review == 1">
                    <then>
                        <assign variable="regularsum" expression="regularsum + 1"/>
                    </then>
                    <else>
                        <if expression="review == 2">
                            <then>
                                <assign variable="goodpercent" expression="goodpercent + 1"/>
                            </then>
                            <else>
                                <if expression="review == 3">
                                    <then>
                                        <assign variable="greatage" expression="greatage + 1"/>
                                        <assign variable="greatavg" expression="greatavg + 1"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <assign variable="greatavg" expression="greatage / greatavg"/>
            <assign variable="goodpercent" expression="goodpercent / 15"/>
            <output expression="&quot;Quantidade de avalia&#231;&#245;es regulares: &quot; &amp;regularsum" newline="True"/>
            <output expression="&quot;Percentual de avalia&#231;&#245;es boas: &quot; &amp; goodpercent &amp; &quot;%&quot;" newline="True"/>
            <output expression="&quot;M&#233;dia de idade das pessoas que avaliaram como &#243;timo: &quot; &amp; greatavg" newline="True"/>
        </body>
    </function>
</flowgorithm>
