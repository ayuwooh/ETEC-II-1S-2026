<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="7 - Contagem de Pessoas Maiores de Idade"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 03:57:36 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjU2OjMwIFBNOzI2NTY="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjU3OjM2IFBNOzE7Mjc3MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="count, age, adult" type="Integer" array="False" size=""/>
            <assign variable="adult" expression="0"/>
            <for variable="count" start="1" end="20" direction="inc" step="1">
                <input variable="age"/>
                <if expression="age &gt;= 18">
                    <then>
                        <assign variable="adult" expression="adult + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Quantidade de pessoas maiores de idade: &quot; &amp; adult" newline="True"/>
        </body>
    </function>
</flowgorithm>
