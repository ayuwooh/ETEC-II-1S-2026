<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1 - Pesquisa Salarial e M&#233;dia de Filhos"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 02:10:00 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAxOjQ4OjQ0IFBNOzI2NjA="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAyOjEwOjAwIFBNOzE7Mjc1MA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sal, children, poor, rich" type="Real" array="False" size=""/>
            <declare name="avgsal, avgchild" type="Real" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <assign variable="rich" expression="0"/>
            <assign variable="poor" expression="0"/>
            <assign variable="avgsal" expression="0"/>
            <assign variable="avgchild" expression="0"/>
            <for variable="count" start="1" end="20" direction="inc" step="1">
                <input variable="sal"/>
                <input variable="children"/>
                <if expression="sal &gt; rich">
                    <then>
                        <assign variable="rich" expression="sal"/>
                    </then>
                    <else/>
                </if>
                <if expression="sal &lt; 1200">
                    <then>
                        <assign variable="poor" expression="poor + 1"/>
                    </then>
                    <else/>
                </if>
                <assign variable="avgsal" expression="avgsal + sal"/>
                <assign variable="avgchild" expression="avgchild + children"/>
            </for>
            <assign variable="avgsal" expression="avgsal / 20"/>
            <assign variable="avgchild" expression="avgchild / 20"/>
            <assign variable="poor" expression="poor / 20"/>
            <output expression="&quot;M&#233;dia de sal&#225;rio: &quot; &amp;avgsal" newline="True"/>
            <output expression="&quot;M&#233;dia de filhos: &quot; &amp;avgchild" newline="True"/>
            <output expression="&quot;Maior sal&#225;rio: R$&quot;&amp;rich" newline="True"/>
            <output expression="&quot;Pessoas com sal&#225;rio abaixo de R$1200.00: &quot; &amp; poor &amp; &quot;%&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
