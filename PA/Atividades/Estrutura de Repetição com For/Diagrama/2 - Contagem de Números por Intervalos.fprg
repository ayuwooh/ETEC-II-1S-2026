<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2 - Contagem de N&#250;meros por Intervalos"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 02:34:32 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAyOjI1OjM1IFBNOzI2NTY="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAyOjM0OjMyIFBNOzI7Mjc2Mg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="range1, range2, range3, range4" type="Integer" array="False" size=""/>
            <declare name="count, num" type="Integer" array="False" size=""/>
            <assign variable="range1" expression="0"/>
            <assign variable="range2" expression="0"/>
            <assign variable="range3" expression="0"/>
            <assign variable="range4" expression="0"/>
            <for variable="count" start="1" end="20" direction="inc" step="1">
                <input variable="num"/>
                <if expression="num &gt;= 0 and num &lt;= 25">
                    <then>
                        <assign variable="range1" expression="range1 + 1"/>
                    </then>
                    <else>
                        <if expression="num &gt;= 26 and num &lt;= 50">
                            <then>
                                <assign variable="range2" expression="range2 + 1"/>
                            </then>
                            <else>
                                <if expression="num &gt;= 51 and num &lt;= 75">
                                    <then>
                                        <assign variable="range3" expression="range3 + 1"/>
                                    </then>
                                    <else>
                                        <if expression="num &gt;= 76 and num &lt;= 100">
                                            <then>
                                                <assign variable="range4" expression="range4 + 1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;0-25: &quot; &amp;range1" newline="True"/>
            <output expression="&quot;26-50: &quot; &amp;range2" newline="True"/>
            <output expression="&quot;51-75: &quot; &amp;range3" newline="True"/>
            <output expression="&quot;76-100: &quot; &amp;range4" newline="True"/>
        </body>
    </function>
</flowgorithm>
