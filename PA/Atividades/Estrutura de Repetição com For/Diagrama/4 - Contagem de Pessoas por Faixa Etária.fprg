<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="4 - Contagem de Pessoas por Faixa Et&#225;ria"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 03:50:30 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjQ0OjE5IFBNOzI2NjA="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjUwOjMwIFBNOzE7Mjc1OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pegi1, pegi2, pegi3, pegi4, pegi5" type="Real" array="False" size=""/>
            <declare name="count, age" type="Integer" array="False" size=""/>
            <assign variable="pegi1" expression="0"/>
            <assign variable="pegi2" expression="0"/>
            <assign variable="pegi3" expression="0"/>
            <assign variable="pegi4" expression="0"/>
            <assign variable="pegi5" expression="0"/>
            <for variable="count" start="1" end="15" direction="inc" step="1">
                <input variable="age"/>
                <if expression="age &gt;= 0 and age &lt;= 15">
                    <then>
                        <assign variable="pegi1" expression="pegi1 + 1"/>
                    </then>
                    <else>
                        <if expression="age &gt;= 16 and age &lt;= 30">
                            <then>
                                <assign variable="pegi2" expression="pegi2 + 1"/>
                            </then>
                            <else>
                                <if expression="age &gt;= 31 and age &lt;= 45">
                                    <then>
                                        <assign variable="pegi3" expression="pegi3 + 1"/>
                                    </then>
                                    <else>
                                        <if expression="age &gt;= 46 and age &lt;= 60">
                                            <then>
                                                <assign variable="pegi4" expression="pegi4 + 1"/>
                                            </then>
                                            <else>
                                                <assign variable="pegi5" expression="pegi5 + 1"/>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;At&#233; 15 anos: &quot;&amp;pegi1" newline="True"/>
            <output expression="&quot;16 a 30: &quot;&amp;pegi2" newline="True"/>
            <output expression="&quot;31 a 45: &quot;&amp;pegi3" newline="True"/>
            <output expression="&quot;46 a 60: &quot;&amp;pegi4" newline="True"/>
            <output expression="&quot;Acima de 61: &quot;&amp;pegi5" newline="True"/>
            <assign variable="pegi1" expression="pegi1 / 15"/>
            <assign variable="pegi5" expression="pegi5 / 15"/>
            <output expression="&quot;Quantia de pessoas at&#233; 15 anos:      &quot; &amp; pegi1 &amp; &quot;%&quot;" newline="True"/>
            <output expression="&quot;Quantia de pessoas acima de 60 anos: &quot; &amp; pegi5 &amp; &quot;%&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
