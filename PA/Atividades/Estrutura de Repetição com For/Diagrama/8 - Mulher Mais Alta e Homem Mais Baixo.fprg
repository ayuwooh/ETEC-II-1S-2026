<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="8 - Mulher Mais Alta e Homem Mais Baixo"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 04:01:44 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjU3OjQwIFBNOzI2NTg="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzA0OjAxOjQ0IFBNOzE7Mjc2MA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="height, shortmale, tallfemale" type="Real" array="False" size=""/>
            <declare name="count, sex" type="Integer" array="False" size=""/>
            <assign variable="tallfemale" expression="0"/>
            <assign variable="shortmale" expression="0"/>
            <for variable="count" start="1" end="20" direction="inc" step="1">
                <input variable="height"/>
                <input variable="sex"/>
                <if expression="sex == 1 and height &gt; tallfemale">
                    <then>
                        <assign variable="tallfemale" expression="height"/>
                    </then>
                    <else>
                        <if expression="sex == 2 and shortmale == 0.0 or height &lt; shortmale">
                            <then>
                                <assign variable="shortmale" expression="height"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;Mulher mais alta: &quot; &amp; tallfemale &amp; &quot;m&quot;" newline="True"/>
            <output expression="&quot;Homem mais baixo: &quot; &amp; shortmale &amp; &quot;m&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
