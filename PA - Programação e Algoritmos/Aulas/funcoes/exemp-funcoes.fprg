    <function name="somar" type="Integer" variable="vsoma">
        <parameters>
            <parameter name="pn1" type="Integer" array="False"/>
            <parameter name="pn2" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="vsoma" type="Integer" array="False" size=""/>
            <assign variable="vsoma" expression="pn1+pn2"/>
        </body>
    </function>
