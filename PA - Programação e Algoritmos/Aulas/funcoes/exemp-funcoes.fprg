    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vnum1, vnum2" type="Integer" array="False" size=""/>
            <input variable="vnum1"/>
            <input variable="vnum2"/>
            <output expression="&quot;O valor da soma &#233; :&quot;&amp;somar(vnum1,vnum2)" newline="True"/>
        </body>
