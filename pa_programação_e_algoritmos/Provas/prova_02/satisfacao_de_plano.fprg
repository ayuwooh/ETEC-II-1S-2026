<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26254"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-28 09:46:47 "/>
        <attribute name="created" value="MjYyNTQ7TEFCNS1NMTk7MjAyNi0wNS0yODsiMDk6MTE6NTEgIjsxOTQ0"/>
        <attribute name="edited" value="MjYyNTQ7TEFCNS1NMTk7MjAyNi0wNS0yODsiMDk6NDY6NDcgIjsxOzIwNjU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="count, satisfaction, age, agesum, great, good, bad" type="Integer" array="False" size=""/>
            <declare name="ageavg" type="Real" array="False" size=""/>
            <assign variable="great" expression="0"/>
            <assign variable="good" expression="0"/>
            <assign variable="bad" expression="0"/>
            <assign variable="agesum" expression="0"/>
            <assign variable="ageavg" expression="0"/>
            <for variable="count" start="1" end="5" direction="inc" step="1">
                <input variable="satisfaction"/>
                <if expression="satisfaction != 1 and satisfaction != 2 and satisfaction != 3">
                    <then>
                        <output expression="&quot;Valor inv&#225;lido&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="satisfaction == 1">
                            <then>
                                <assign variable="great" expression="great + 1"/>
                            </then>
                            <else>
                                <if expression="satisfaction == 2">
                                    <then>
                                        <assign variable="good" expression="good + 1"/>
                                    </then>
                                    <else>
                                        <if expression="satisfaction == 3">
                                            <then>
                                                <assign variable="bad" expression="bad + 1"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <input variable="age"/>
                <assign variable="agesum" expression="agesum + age"/>
            </for>
            <assign variable="ageavg" expression="agesum / 5"/>
            <output expression="&quot;Avalia&#231;&#245;es:&quot;" newline="True"/>
            <output expression="&quot;&#211;timo: &quot; &amp;great" newline="True"/>
            <output expression="&quot;Bom: &quot; &amp;good" newline="True"/>
            <output expression="&quot;Ruim: &quot; &amp;bad" newline="True"/>
            <output expression="&quot;Idade m&#233;dia: &quot; &amp;ageavg" newline="True"/>
        </body>
    </function>
</flowgorithm>
