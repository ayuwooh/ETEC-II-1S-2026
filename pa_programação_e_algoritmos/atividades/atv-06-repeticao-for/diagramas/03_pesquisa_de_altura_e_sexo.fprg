<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="3 - Pesquisa de Altura e Sexo"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 03:44:13 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjM4OjAzIFBNOzI2NTY="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjQ0OjEzIFBNOzE7Mjc2Mg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="count, height, sex, women, tall, short" type="Integer" array="False" size=""/>
            <declare name="wsum, hsum" type="Real" array="False" size=""/>
            <assign variable="tall" expression="0"/>
            <assign variable="short" expression="0"/>
            <assign variable="women" expression="0"/>
            <assign variable="wsum" expression="0"/>
            <assign variable="hsum" expression="0"/>
            <for variable="count" start="1" end="50" direction="inc" step="1">
                <input variable="height"/>
                <input variable="sex"/>
                <if expression="tall == 0 or height &gt; tall">
                    <then>
                        <assign variable="tall" expression="height"/>
                    </then>
                    <else>
                        <if expression="short == 0 or height &lt; short">
                            <then>
                                <assign variable="short" expression="height"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
                <if expression="sex == 2">
                    <then>
                        <assign variable="women" expression="women + 1"/>
                        <assign variable="wsum" expression="wsum + height"/>
                    </then>
                    <else/>
                </if>
                <assign variable="hsum" expression="hsum + height"/>
            </for>
            <assign variable="wsum" expression="wsum / women"/>
            <assign variable="hsum" expression="hsum / 50"/>
            <output expression="&quot;Maior altura:                 &quot; &amp;tall" newline="True"/>
            <output expression="&quot;Menor altura:                 &quot;&amp;short" newline="True"/>
            <output expression="&quot;M&#233;dia de altura das mulheres: &quot;&amp;wsum" newline="True"/>
            <output expression="&quot;M&#233;dia de altura da turma:     &quot;&amp;hsum" newline="True"/>
        </body>
    </function>
</flowgorithm>
