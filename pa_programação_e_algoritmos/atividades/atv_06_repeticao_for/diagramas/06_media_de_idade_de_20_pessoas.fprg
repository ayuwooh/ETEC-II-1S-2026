<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="6 - M&#233;dia de Idade de 20 Pessoas"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-12 03:56:25 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjU1OjEzIFBNOzI2NTY="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA1LTEyOzAzOjU2OjI1IFBNOzE7Mjc2OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="count, age" type="Integer" array="False" size=""/>
            <declare name="avgage" type="Integer" array="False" size=""/>
            <assign variable="avgage" expression="0"/>
            <for variable="count" start="1" end="20" direction="inc" step="1">
                <input variable="age"/>
                <assign variable="avgage" expression="avgage + age"/>
            </for>
            <assign variable="avgage" expression="avgage / 20"/>
            <output expression="&quot;M&#233;dia de idade das pessoas: &quot; &amp; avgage" newline="True"/>
        </body>
    </function>
</flowgorithm>
