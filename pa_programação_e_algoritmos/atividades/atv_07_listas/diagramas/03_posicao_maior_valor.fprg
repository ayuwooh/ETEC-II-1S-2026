<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="3-posicao-maior-valor"/>
        <attribute name="authors" value="ayuwooh"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-01 02:53:16 PM"/>
        <attribute name="created" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA2LTAxOzAyOjQ3OjMzIFBNOzI2NTc="/>
        <attribute name="edited" value="YXl1d29vaDtTSUxFTkNFUjsyMDI2LTA2LTAxOzAyOjUzOjE2IFBNOzE7Mjc2Mw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nums" type="Integer" array="True" size="10"/>
            <declare name="count, num" type="Integer" array="False" size=""/>
            <assign variable="count" expression="0"/>
            <while expression="count &lt; 10">
                <input variable="num"/>
                <assign variable="nums[count]" expression="num"/>
                <assign variable="count" expression="count + 1"/>
            </while>
            <declare name="maxnum, pos, index" type="Integer" array="False" size=""/>
            <assign variable="maxnum" expression="nums[0]"/>
            <assign variable="pos" expression="0"/>
            <assign variable="index" expression="1"/>
            <while expression="index &lt; 10">
                <if expression="nums[index] &gt; maxnum">
                    <then>
                        <assign variable="maxnum" expression="nums[index]"/>
                        <assign variable="pos" expression="index"/>
                    </then>
                    <else/>
                </if>
                <assign variable="index" expression="index + 1"/>
            </while>
            <output expression="&quot;A posi&#231;&#227;o do maior valor na lista &#233;: &quot; &amp;pos" newline="True"/>
        </body>
    </function>
</flowgorithm>
