<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="26254"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-25 09:30:26 "/>
        <attribute name="created" value="MjYyNTQ7TEFCNS1NMTk7MjAyNi0wNi0yNTsiMDk6MjM6MTEgIjsxOTQx"/>
        <attribute name="edited" value="MjYyNTQ7TEFCNS1NMTk7MjAyNi0wNi0yNTsiMDk6MzA6MjYgIjsxOzIwNTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, j, bignums, lownums" type="Integer" array="False" size=""/>
            <declare name="nums" type="Integer" array="True" size="20"/>
            <assign variable="i" expression="0"/>
            <for variable="i" start="0" end="19" direction="inc" step="1">
                <input variable="nums[i]"/>
            </for>
            <assign variable="j" expression="0"/>
            <assign variable="bignums" expression="0"/>
            <assign variable="lownums" expression="0"/>
            <for variable="j" start="0" end="19" direction="inc" step="1">
                <if expression="nums[j] &gt;= 10">
                    <then>
                        <assign variable="bignums" expression="bignums + 1"/>
                    </then>
                    <else>
                        <assign variable="lownums" expression="lownums + 1"/>
                    </else>
                </if>
            </for>
            <output expression="&quot;N&#250;meros maiores ou igual a 10: &quot; &amp;bignums" newline="True"/>
            <output expression="&quot;N&#250;meros menores que 10: &quot; &amp;lownums" newline="True"/>
        </body>
    </function>
</flowgorithm>
